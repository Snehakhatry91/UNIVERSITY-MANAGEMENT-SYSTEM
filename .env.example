# CVGU Secure Hybrid Cloud Management System
# Environment Configuration Template
# Copy this file to .env or .env.local to customize local parameters

# Application Environment Mode (development | staging | production)
VITE_APP_ENV=development

# Simulated Telemetry Interval (milliseconds)
VITE_TELEMETRY_REFRESH_INTERVAL=2000

# Institution Details (used for CAD Title Block & Reporting)
VITE_INSTITUTION_NAME="C. V. Raman Global University"
VITE_PROJECT_NAME="CVGU Hybrid Cloud Management System"
VITE_DOCUMENT_REVISION="v2.4"

# Optional Cloud Region Reference (ap-south-1 | us-east-1 | eu-west-1)
VITE_AWS_PRIMARY_REGION="ap-south-1"
